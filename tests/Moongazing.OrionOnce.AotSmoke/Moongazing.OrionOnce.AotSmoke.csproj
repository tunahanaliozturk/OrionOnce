<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      NativeAOT publish smoke test. `dotnet publish` on this project must succeed with zero
      trim/AOT warnings, exercising the idempotency store end to end (DI registration, acquire,
      complete, replay, fingerprint mismatch) in a rooted, trimmed, native binary - proving the
      idempotency primitive has no reflection and survives trimming.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Moongazing.OrionOnce\Moongazing.OrionOnce.csproj" />
  </ItemGroup>
</Project>
